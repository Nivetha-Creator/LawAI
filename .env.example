# Leave unset for Cursor Cloud Agent and normal local Vite use.
# The Vite dev server proxies /chat, /debate, /conversations, and /health
# to http://127.0.0.1:8000 so the browser never calls 127.0.0.1 directly.
#
# Local direct API (optional; usually leave unset and use the Vite proxy):
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Render static site (set in the frontend service Environment, then redeploy):
# VITE_API_BASE_URL=https://lawai-0i1a.onrender.com
