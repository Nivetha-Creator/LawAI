# Optional SQLite path (default: backend/lawyerai.db)
# DATABASE_PATH=lawyerai.db

# Optional LLM FALLBACK for Ask Me Anything when the local knowledge base
# cannot answer, and for Legal Strategy enrichment when no curated law matched.
# Disabled by default — leave these unset for fully local use.
# LAWYERAI_USE_LLM=0
# Provider id. Only "gemini" is implemented. Defaults to gemini when unset.
# LAWYERAI_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_actual_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=25

# Optional local retrieval. Off by default. Does not use a hosted embedding API.
# LAWYERAI_RAG_ENABLED=false
# LAWYERAI_CHROMA_PATH=data/chroma
# LAWYERAI_CHROMA_COLLECTION=legal_chunks
# LAWYERAI_EMBEDDING_PROVIDER=local-minilm
# Squared Euclidean cutoff (Chroma's default hnsw:space=l2, sum of squares,
# not cosine and not the square root). Lower is closer. There is no upper bound.
# Unset or blank uses the provisional uncalibrated default of 1.0.
# That number has not been measured on a real index. It can drop useful chunks
# and can still admit weak ones. Calibrate on your own Chroma collection
# before relying on it. Negative, NaN, and infinity are rejected.
# LAWYERAI_RAG_MAX_DISTANCE=1.0
