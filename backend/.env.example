# Optional SQLite path (default: backend/lawyerai.db)
# DATABASE_PATH=lawyerai.db

# Optional Gemini FALLBACK for Ask Me Anything when the local knowledge base
# cannot answer. Disabled by default — leave these unset for fully local use.
# LAWYERAI_USE_LLM=0
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=25
